# Example environment configuration for Valence
# Copy to .env and adjust values as needed. None of these are required —
# Valence runs with built-in defaults if unset.

VALENCE_DEBUG=true
VALENCE_EXTERN_PORT=3030
VALENCE_CACHE_URL=redis://127.0.0.1:6379
VALENCE_CACHE_TTL_SECS=600
VALENCE_BODY_LIMIT_BYTES=8192

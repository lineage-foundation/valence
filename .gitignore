# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Cargo.lock is committed: valence is an executable, so a pinned lockfile gives
# reproducible builds. https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

.DS_Store

*.rdb

